# Copy to config.env and fill in. config.env is gitignored -- the companion token
# must never be committed, and rotating AGENTHUB_COMPANION_TOKEN on office-server
# is the only way to revoke this device.

# The office. LAN only, per the design note -- Cubie never takes a tunnel path.
# NOTE: the office moved to office-server on 2026-08-25. Not the Pi.
OFFICE_HUB=http://office-server.local:8420
AGENTHUB_COMPANION_TOKEN=paste-the-companion-token-here

# The stackchan-mcp gateway. Cubie dials OUT to this, so it is a LAN address the
# device can reach -- not localhost, unless the bridge runs on the same machine.
STACKCHAN_GATEWAY_HOST=office-server.local
STACKCHAN_GATEWAY_PORT=8765
STACKCHAN_TOKEN=paste-the-gateway-token-here

# Where the device POSTs camera frames (gateway HTTP capture server).
VISION_HOST=office-server.local

# --- the brain (pa/live.py) -------------------------------------------------
# WITHOUT this, tap-to-talk is off and everything else still runs -- idle
# motion, breathing, the face, head-pet. It says so once at startup.
#
# It lives in /etc/cubie-character.env on office-server, not here: this file is
# the example, and the service reads the real one. Mode 0600, root-owned.
ANTHROPIC_API_KEY=paste-the-api-key-here

# Which brain runs a turn.
#
#   auto (default)  the API key when there is one, otherwise the CLI
#   api             the Messages API, billed to ANTHROPIC_API_KEY
#   cli             a headless `claude` on this machine, billed to whatever
#                   that CLI is logged in as -- no API key needed
#
# `cli` exists because office-server already spawns headless `claude` for the
# office's own agents (agents/claudeCommand.ts), so the machine on his desk can
# run a model without a second billing relationship. It costs a process spawn
# per turn -- measured at ~3.7s for a trivial prompt against roughly 2s for a
# direct POST -- so he gains a beat before answering.
#
# `auto` prefers the key deliberately: upgrading this repo must never silently
# move an existing deployment onto a different model or a different bill. Set
# `cli` explicitly to switch, and note that a key that is PRESENT but wrong
# still wins under `auto` -- which is its own failure mode, so if you mean the
# CLI, say so here rather than leaving a stale key in place.
CUBIE_BRAIN=auto

# Sonnet for conversation: latency is what a person waiting notices, and a turn
# is a short exchange rather than a reasoning problem. Under CUBIE_BRAIN=cli
# this is passed as --model; leave it empty there to take the CLI's own
# default rather than pinning a model in a second place.
CUBIE_MODEL=claude-sonnet-5

# How long he records after a tap. The device's own VAD would be better -- it
# stops when you stop -- but that path needs a webhook we do not serve yet.
CUBIE_LISTEN_MS=5000

# How much the head moves when idle: 0 none, 1 every 8-12s, 2 every 4-8s
# (default), 3 every 2-4s. The FACE drifts at every level, including 0.
CUBIE_IDLE_LEVEL=2

# --- the bridge (bridge/) ---------------------------------------------------
# The bridge runs ON office-server, beside the gateway. That is not a
# convenience: the gateway's MCP control surface binds to loopback
# (MCP_HTTP_HOST=127.0.0.1) so it is not reachable from the LAN, and the bridge
# is a client of it.
#
# Note the two different gateway ports. STACKCHAN_GATEWAY_PORT above is 8765 --
# the WebSocket the *device* dials in on, LAN-facing. This is 8767, the control
# surface, loopback-only.
CUBIE_GATEWAY_MCP_URL=http://127.0.0.1:8767/mcp

# How often the bridge reads the office. The office caps its own cost; this is
# about how quickly Cubie notices, not about load.
CUBIE_POLL_MS=5000
