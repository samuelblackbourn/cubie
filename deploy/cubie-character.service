# Cubie's character stack: the M5 modifier port, running against the gateway.
#
#   sudo cp deploy/cubie-character.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cubie-character
#
# This is the thing that makes him look alive: breathing, blinking asserted,
# the gaze drifting, the head looking around, and a reaction to being stroked.
# `pa/idle.py` had been written for weeks with nothing running it, which is
# exactly why the head was not moving -- so this unit is the missing half.
#
# Reads /etc/cubie-character.env. Mode 0600, root-owned, like the gateway's.
#
#   STACKCHAN_TOKEN            required -- the gateway's tool surface
#   ANTHROPIC_API_KEY          the brain. WITHOUT IT tap-to-talk is off and
#                              everything else still runs; it says so once at
#                              startup rather than failing.
#   AGENTHUB_COMPANION_TOKEN   the office's companion API, so he can read what
#                              is waiting and approve or decline it
#   OFFICE_HUB                 default http://office-server.local:8420
#   CUBIE_MODEL                default claude-sonnet-5
#   CUBIE_LISTEN_MS            default 5000
#   CUBIE_IDLE_LEVEL           0-3, default 2
#
# Create it by DERIVING the token from the gateway's own env file, so the value
# is never printed to a terminal (this repo's rule: no command it ships may
# echo a secret, and terminals get pasted into chat):
#
#   sudo sh -c 'umask 077; printf "STACKCHAN_TOKEN=%s\n" \
#     "$(sed -nE "s/^STACKCHAN_TOKEN=//p" /etc/stackchan-gateway.env | tr -d "\042\047")" \
#     > /etc/cubie-character.env'
#   sudo awk -F= '/^STACKCHAN_TOKEN=/{print "token length:", length($2)}' \
#     /etc/cubie-character.env      # expect 64
#
# Do NOT symlink this to /etc/cubie-bridge.env. That file does not exist --
# the bridge is written but has never been deployed -- and systemd answers a
# dangling EnvironmentFile with "Failed to load environment files" reported as
# result 'resources', which reads like a resource problem and is a missing
# file. That instruction was in this comment once and cost a debugging round.
#
# The cost of a dedicated file is that the token now lives in two places, so
# rotating the gateway's means rewriting this one too -- rerun the command
# above and restart this unit.
[Unit]
Description=Cubie character stack (M5 modifiers: idle, breath, gaze, touch)
Documentation=https://github.com/samuelblackbourn/cubie
# Give up rather than loop forever on a configuration error: a bad
# EnvironmentFile retried 33 times before anyone looked, filling the journal
# and never surfacing as a failed unit.
#
# This is safe to make strict only because the PROCESS rides out a gateway
# restart itself (pa/live.py retries the connection for up to five minutes with
# backoff) rather than exiting and leaning on Restart= to reconnect. Without
# that, five tries at five-second intervals would give a routine
# `systemctl restart stackchan-gateway` about 25 seconds to come back before
# systemd gave up on the character stack for good.
StartLimitIntervalSec=300
StartLimitBurst=5
# The gateway owns the device connection and the loopback MCP surface this
# dials; without it there is nothing to drive.
After=network-online.target stackchan-gateway.service
Wants=network-online.target stackchan-gateway.service

[Service]
Type=simple
User=sam
WorkingDirectory=/home/sam/cubie/pa
EnvironmentFile=/etc/cubie-character.env
# The GATEWAY's interpreter, not pa/.venv: the `mcp` package lives there and
# nowhere else. The character logic itself imports nothing from it -- the
# robot is behind a protocol precisely so pa/.venv can run the tests.
ExecStart=/home/sam/stackchan-gateway/bin/python /home/sam/cubie/pa/live.py
# The gateway restarts, the device drops off Wi-Fi, the robot gets unplugged.
# None of those should end the character; restart is the backstop for a crash.
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# read-only rather than yes: the interpreter and the code both live under
# /home/sam, so the process has to be able to read there.
ProtectHome=read-only

# NOT VERIFIED FROM THE SANDBOX: whether this User can read the gateway's
# event log. The gateway writes it under its own StateDirectory
# (/var/lib/stackchan-gateway/.claude/stackchan-events.jsonl), owned by
# whichever user the gateway runs as. If this user cannot read it, touch
# events never arrive and the head-pet reaction looks broken rather than
# unreadable. Check before blaming the code:
#
#   sudo -u sam test -r /var/lib/stackchan-gateway/.claude/stackchan-events.jsonl #       && echo readable || echo NOT READABLE
#
# If it is not, point both ends at a shared path instead of loosening
# permissions on the gateway's state -- set jsonl.path in notify.yml and
# STACKCHAN_EVENTS_PATH here to the same file.

[Install]
WantedBy=multi-user.target
