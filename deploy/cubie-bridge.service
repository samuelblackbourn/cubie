# Cubie's bridge. Install on office-server, beside the gateway.
#
#   sudo cp deploy/cubie-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cubie-bridge
#
# Reads its configuration from /etc/cubie-bridge.env, which must carry
# AGENTHUB_COMPANION_TOKEN and STACKCHAN_TOKEN. Two tokens, deliberately: one
# guards office state, the other the robot's tool surface, and they are
# independently rotatable. Mode 0600, root-owned, like the gateway's.
[Unit]
Description=Cubie bridge (office state -> posture)
Documentation=https://github.com/samuelblackbourn/cubie
# The gateway owns the device connection; without it there is nothing to drive.
After=network-online.target stackchan-gateway.service
Wants=network-online.target stackchan-gateway.service

[Service]
Type=simple
User=sam
WorkingDirectory=/home/sam/cubie/bridge
EnvironmentFile=/etc/cubie-bridge.env
ExecStart=/usr/bin/node --experimental-strip-types src/index.ts
# The office and the gateway both come and go; the bridge is meant to ride that
# out rather than exit. Restart is the backstop for a crash, not the mechanism.
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
